{
  "name": "codex-temporary-mode",
  "version": "3.2.5",
  "private": false,
  "type": "module",
  "description": "Temporary chats and local Delta and Pipeline Mode acceleration for Codex",
  "scripts": {
    "postinstall": "node build/postinstall.mjs",
    "test": "node --test",
    "patch:vscode": "node patch.mjs --vscode",
    "restore:vscode": "node patch.mjs --uninstall --vscode",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run test:build",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test:build": "npm run build && node scripts/verify-build.mjs"
  },
  "license": "MIT",
  "bin": {
    "codex-temporary-mode": "build/codex-temporary-mode.mjs",
    "temp-codex": "build/temp-codex.mjs",
    "codex-accelerator": "build/codex-accelerator.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "build/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "codex",
    "mcp",
    "delta-mode",
    "pipeline-mode",
    "temporary-chat",
    "cli",
    "vscode"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonu-mamsys/codex-temporary-mode.git"
  },
  "homepage": "https://github.com/sonu-mamsys/codex-temporary-mode#readme",
  "bugs": {
    "url": "https://github.com/sonu-mamsys/codex-temporary-mode/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.5"
  }
}
